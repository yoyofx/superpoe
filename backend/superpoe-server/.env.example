# Listen only behind the existing Nginx reverse proxy.
SUPERPOE_SERVER_ADDR=127.0.0.1:8787

# MySQL 8 DSN. The server adds parseTime, UTC and utf8mb4 options.
SUPERPOE_MYSQL_DSN='superpoe_auth:change-me@tcp(127.0.0.1:3306)/superpoe_auth'

# Public HTTPS origin used in email links and browser CORS.
SUPERPOE_PUBLIC_BASE_URL=https://auth.example.com
# Comma-separated CORS allowlist. Include packaged Electron and Vite dev
# origins when the desktop client calls this service.
SUPERPOE_ALLOWED_ORIGIN=app://localhost,http://127.0.0.1:3000,https://app.example.com

# Exactly 32 random bytes, encoded as unpadded base64 or hexadecimal.
# PowerShell: $b=[byte[]]::new(32); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
SUPERPOE_DATA_ENCRYPTION_KEY=

SUPERPOE_ACCESS_TTL=15m
SUPERPOE_REFRESH_TTL=720h
SUPERPOE_PASSWORD_RESET_TTL=20m
SUPERPOE_EMAIL_VERIFICATION_TTL=24h
SUPERPOE_PASSWORD_HASH_CONCURRENCY=2
SUPERPOE_AUTH_RATE_LIMIT=60
SUPERPOE_AUTH_RATE_WINDOW=1m
SUPERPOE_AUTH_RATE_MAX_KEYS=10000

# Leave SMTP_HOST empty for local development. Production should configure a
# provider that supports authenticated TLS and a sender on the app domain.
SUPERPOE_SMTP_HOST=
SUPERPOE_SMTP_PORT=587
SUPERPOE_SMTP_USER=
SUPERPOE_SMTP_PASSWORD=
SUPERPOE_SMTP_FROM='SuperPoE <no-reply@example.com>'
SUPERPOE_SECURE_COOKIES=1
