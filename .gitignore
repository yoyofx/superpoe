# External resources (not committed, copy on setup)
upstreams/
Builds/

# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
tsconfig.tsbuildinfo

# Frontend runtime files. Everything under public/ is served by the app and
# must be committed so fresh checkouts do not miss tree data or images.
!public/
!public/**

# Logs and local scratch files
*.log
log.txt
_tsc*.txt
.cache/

# Local development run artifacts
/dev-*.out
/dev-*.err
/dev-data/*
!/dev-data/README.md
/release-local-*/

# Local deployment secrets for the authentication database
backend/superpoe-server/.env.mysql
backend/superpoe-server/DEPLOYMENT-SECRETS.local.md

# Python cache
__pycache__/
*.py[cod]

# External tool downloads
scripts/texconv.zip

# Prebuilt native runtimes are committed and packaged through extraResources.

# Runtime sprite assets generated/copied by the resource pipeline.
# These are committed so a fresh checkout can render the passive tree without
# requiring local game sources or a pipeline run first.
