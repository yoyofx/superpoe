# External resources (not committed, copy on setup)
upstreams/
Builds/

# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
tsconfig.tsbuildinfo

# Frontend runtime files. Everything under public/ is served by the app and
# must be committed so fresh checkouts do not miss tree data or images.
!public/
!public/**

# Logs and local scratch files
*.log
log.txt
_tsc*.txt
.cache/

# Committed development snapshots may contain LevelDB log files.
!dev-data/
!dev-data/**

# Python cache
__pycache__/
*.py[cod]

# External tool downloads
scripts/texconv.zip

# Runtime sprite assets generated/copied by the resource pipeline.
# These are committed so a fresh checkout can render the passive tree without
# requiring local game sources or a pipeline run first.
